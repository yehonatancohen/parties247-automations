# Instagram Stories Automation - Environment Variables
# Copy this file to .env and fill in your values

# === Telegram Configuration ===
# NOTE: Uses a SEPARATE bot from Video Creator to avoid conflicts
# Create a new bot with @BotFather for this project
IG_TELEGRAM_TOKEN=
IG_TELEGRAM_INT_TOKEN=

# Allowed users (comma-separated list of Telegram user IDs)
ALLOWED_USER_ID=985770181
# ALLOWED_USER_IDS=123456789,987654321  # For multiple users

# === Instagram Configuration ===
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Session file name (optional, default: instagram_session.json)
# INSTAGRAM_SESSION_FILE=instagram_session.json

# === Environment ===
APP_ENV=local  # Set to 'production' for production
