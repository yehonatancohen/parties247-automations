# Copy to .env (git-ignored) (never commit it) and fill in on the VPS.
MCP_PATH_SECRET=            # python -c "import secrets;print(secrets.token_urlsafe(32))"
PUBLIC_BASE_URL=https://video.parties247.co.il
PUBLISH_MODE=manual
TELEGRAM_TOKEN=
ALLOWED_USER_ID=
GEMINI_API_KEY=
CLOUDFLARE_TUNNEL_TOKEN=
# Instagram (only when PUBLISH_MODE=instagram): long-lived token from the Meta app dashboard
IG_ACCESS_TOKEN=
APPROVAL_CODE_REQUIRED=1
# Optional dry-run account: set IG_TEST_ACCESS_TOKEN and IG_TARGET=test, restart, publish, then set IG_TARGET=main
IG_TEST_ACCESS_TOKEN=
IG_TARGET=main
